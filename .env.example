# GEMINI_API_KEY: Optional Gemini API key if extending with AI features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign HTTPOnly JWT authentication cookies.
JWT_SECRET="replace-with-a-long-random-secret-string"

# IMGBB_API_KEY: Optional ImgBB API key for external image hosting.
# When omitted, StudioSpace automatically stores uploaded studio imagery locally under /uploads.
IMGBB_API_KEY=""
